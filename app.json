{
  "expo": {
    "name": "Listup",
    "slug": "comprar-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2F0EF"
      },
      "package": "com.lucasamadio.comprarapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "37b7cfe0-0ebf-4c77-91a8-147c68bc23a1"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F2F0EF",
          "imageWidth": 200
        }
      ],
      "expo-font"
    ]
  }
}
